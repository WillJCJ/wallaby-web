{
  "all": true,
  "include": [
    "site/scripts/**/*.js",
    "worker/**/*.js"
  ],
  "exclude": [
    "node_modules/**",
    "dist/**",
    ".wrangler/**",
    "**/*.test.js",
    "**/*.config.js",
    "site/_includes/**",
    "site/styles/**"
  ],
  "reporter": [
    "text",
    "html",
    "json"
  ],
  "lines": 50,
  "functions": 50,
  "branches": 50,
  "statements": 50
}