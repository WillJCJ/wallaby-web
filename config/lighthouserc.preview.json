{
  "ci": {
    "collect": {
      "url": [
        "https://wallaby-web-preview.willjcjohnson.workers.dev/",
       "https://wallaby-web-preview.willjcjohnson.workers.dev/festival-map/",
       "https://wallaby-web-preview.willjcjohnson.workers.dev/wallabies/",
       "https://wallaby-web-preview.willjcjohnson.workers.dev/game/"
      ],
      "settings": {
        "skipAudits": [
          "color-contrast"
        ]
      },
      "numberOfRuns": 1
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "color-contrast": "off",
         "document-latency-insight": "off",
         "image-delivery-insight": "off",
         "lcp-discovery-insight": "off",
         "network-dependency-tree-insight": "off",
         "redirects": "off",
         "unminified-javascript": "off",
         "uses-responsive-images": "off",
        "categories:performance": ["error", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    }
  }
}