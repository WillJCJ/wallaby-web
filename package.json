{
  "name": "wallaby-web",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@eslint/js": "^10.0.0",
    "@shopify/prettier-plugin-liquid": "^1.11.0",
    "c8": "^12.0.0",
    "clean-css": "^5.3.1",
    "depcheck": "^1.4.7",
    "eslint": "^10.8.1",
    "eslint-plugin-complexity": "^1.0.2",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.0.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "html-minifier-next": "^7.5.2",
    "jsdom": "^30.0.1",
    "luxon": "^3.7.2",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:format && npm run lint:md",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix && npm run lint:format:fix && npm run lint:md:fix",
    "lint:js": "eslint --config config/eslint.config.js .",
    "lint:js:fix": "eslint --config config/eslint.config.js --fix .",
    "lint:css": "stylelint --config config/stylelint.config.json 'site/styles/**/*.css'",
    "lint:css:fix": "stylelint --config config/stylelint.config.json --fix 'site/styles/**/*.css'",
    "lint:format": "prettier --config config/prettier.config.json --check 'site/**/*.html' 'site/styles/**/*.css' 'site/**/*.liquid' '!site/**/*.js.liquid'",
    "lint:format:fix": "prettier --config config/prettier.config.json --write 'site/**/*.html' 'site/styles/**/*.css' 'site/**/*.liquid' '!site/**/*.js.liquid'",
    "lint:md": "markdownlint-cli2 '**/*.md' --config config/markdownlint-cli2.jsonc",
    "lint:md:fix": "markdownlint-cli2 '**/*.md' --config config/markdownlint-cli2.jsonc --fix",
    "build:clean": "rm -rf dist",
    "build:html": "eleventy --config config/eleventy.config.js --input=site --output=dist",
    "build": "npm run build:clean && npm run build:html",
    "dev": "eleventy --config config/eleventy.config.js --input=site --output=dist --serve",
    "dev:wrangler": "MINIFY=false wrangler dev --live-reload --var DEV_AUTH_ENABLED:true --var DEV_AUTH_ALLOWED_HOSTS:localhost,127.0.0.1,::1 --var ADMIN_EMAILS:admin@example.com",
    "wrangler:types": "wrangler types",
    "wrangler:types:check": "wrangler types --check",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production",
    "d1:migrate:production": "wrangler d1 migrations apply GUESTS_DB --env production --remote",
    "d1:migrate:local": "wrangler d1 migrations apply GUESTS_DB --local",
    "d1:seed:local": "npm run d1:migrate:local && wrangler d1 execute wallabyfest-guests-preview --local --file scripts/seed-local-guests.sql",
    "d1:reset-high-scores": "node scripts/reset-high-scores.js",
    "r2:sync-local": "node scripts/sync-r2-local.js",
    "test": "vitest run --config config/vitest.config.js",
    "test:watch": "vitest --config config/vitest.config.js",
    "test:coverage": "c8 --config config/c8.json npm run test",
    "lint:check-deps": "depcheck --config=config/depcheck.json"
  }
}
