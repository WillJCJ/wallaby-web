{
  "name": "wallaby-web",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0-beta.1",
    "@eslint/js": "^10.0.0",
    "clean-css": "^5.3.1",
    "eslint": "^10.0.0",
    "eslint-plugin-html": "^8.1.3",
    "globals": "^17.0.0",
    "html-minifier-next": "^5.2.2",
    "wrangler": "^4.81.1"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "build:clean": "rm -rf dist",
    "build:html": "eleventy --config eleventy.js --input=site --output=dist",
    "build": "npm run build:clean && npm run build:html",
    "dev": "eleventy --config eleventy.js --input=site --output=dist --serve"
  }
}
