{
  "name": "wallaby-web",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0-beta.1",
    "@eslint/js": "^10.0.0",
    "clean-css": "^5.3.1",
    "eslint": "^10.2.1",
    "eslint-plugin-html": "^8.1.3",
    "globals": "^17.5.0",
    "html-minifier-next": "^6.1.2",
    "sharp": "^0.34.5",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.83.0"
  },
  "scripts": {
    "lint": "eslint . && stylelint 'site/styles/**/*.css'",
    "lint:fix": "eslint --fix . && stylelint --fix 'site/styles/**/*.css'",
    "build:clean": "rm -rf dist",
    "build:html": "eleventy --config eleventy.js --input=site --output=dist",
    "build": "npm run build:clean && npm run build:html",
    "dev": "eleventy --config eleventy.js --input=site --output=dist --serve",
    "dev:wrangler": "MINIFY=false wrangler dev --live-reload",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
