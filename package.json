{
  "name": "wallaby-web",
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0-beta.1",
    "@eslint/js": "^10.0.0",
    "@lhci/cli": "^0.12.0",
    "@shopify/prettier-plugin-liquid": "^1.10.0",
    "c8": "^11.0.0",
    "clean-css": "^5.3.1",
    "depcheck": "^1.4.7",
    "eslint": "^10.2.1",
    "eslint-plugin-complexity": "^1.0.2",
    "eslint-plugin-html": "^8.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.5.0",
    "html-minifier-next": "^6.1.2",
    "jsdom": "^29.1.0",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.83.0"
  },
  "scripts": {
    "lint": "eslint . && stylelint 'site/styles/**/*.css' && prettier --check 'site/**/*.html' 'site/styles/**/*.css' 'site/**/*.liquid' '!site/**/*.js.liquid' && markdownlint-cli2 '**/*.md'",
    "lint:fix": "eslint --fix . && stylelint --fix 'site/styles/**/*.css' && prettier --write 'site/**/*.html' 'site/styles/**/*.css' 'site/**/*.liquid' '!site/**/*.js.liquid' && markdownlint-cli2 --fix '**/*.md'",
    "build:clean": "rm -rf dist",
    "build:html": "eleventy --config eleventy.js --input=site --output=dist",
    "build": "npm run build:clean && npm run build:html",
    "dev": "eleventy --config eleventy.js --input=site --output=dist --serve",
    "dev:wrangler": "MINIFY=false wrangler dev --live-reload --var DEV_AUTH_ENABLED:true --var DEV_AUTH_ALLOWED_HOSTS:localhost,127.0.0.1,::1 --var ADMIN_EMAILS:admin@example.com",
    "d1:migrate:local": "wrangler d1 execute wallabyfest-guests-preview --local --file migrations/0001_create_guests.sql && wrangler d1 execute wallabyfest-guests-preview --local --file migrations/0002_add_guest_access_state.sql",
    "d1:seed:local": "npm run d1:migrate:local && wrangler d1 execute wallabyfest-guests-preview --local --file scripts/seed-local-guests.sql",
    "d1:reset-high-scores": "node scripts/reset-high-scores.js",
    "r2:sync-local": "node scripts/sync-r2-local.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "c8 npm run test",
    "lint:check-deps": "depcheck"
  }
}
